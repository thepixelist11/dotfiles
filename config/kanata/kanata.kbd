(defcfg
    process-unmapped-keys yes
)

(defvar
    tap-time 200
    hold-time 200
)

(defalias
    mwu (mwheel-up 50 120)
    mwd (mwheel-down 50 120)
)

(defsrc
  esc  f1  f2  f3  f4  f5  f6  f7  f8  f9  f10  f11  f12   ins  prtsc  del  home  end  pgup  pgdn
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc     nlck  kp/  kp*   kp-
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \        kp7   kp8  kp9   kp+
  caps a    s    d    f    g    h    j    k    l    ;    '    ret           kp4   kp5  kp6
  lsft z    x    c    v    b    n    m    ,    .    /    rsft               kp1   kp2  kp3   kprt
  lctl lmet lalt           spc            ralt rmet rctl        up          kp0        kp.
                                                         left   down   right
)

(defalias
  grv (tap-hold-press $tap-time $hold-time grv (layer-toggle vim))
)

(deflayer default
  _    _   _   _   _   _   _   _   _   _   _    _    _     _    _      _    _     _    _     _
  @grv _    _    _    _    _    _    _    _    _    _    _    _    _        _     _    _     _
  _    _    _    _    _    _    _    _    _    _    _    _    _    _        _     _    _     _
  esc  _    _    _    _    _    _    _    _    _    _    _    _             _     _    _
  _    _    _    _    _    _    _    _    _    _    _    _                  _     _    _     _
  _    _    _              _              _    _    _           _           _          _
                                                         _      _      _
)

(deflayer vim
  _    _   _   _   _   _   _   _   _    _   _   _     _      _     _    _        _     _    _     _
  @grv _    _    _    end  _    _    _     _   _     home _    _    _        _     _    _     _
  _    _    _    mwd  _    _    mwu  _     _   _     _    _    _    _        _     _    _     _
  esc  _    _    _    _    _    left down  up  right      _    _    _        _     _    _
  _    _    _    _    _    _    _    _     _   _     _    _                  _     _    _     _
  _    _    _              _               _   _     _            _          _          _
                                                                 _      _      _
)




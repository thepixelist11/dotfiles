# GENERATED by scripts/theme_manager.py on every palette change.
# Read by btop as `color_theme = "impasto"`; edits here are lost at the
# next theme switch.
#
# btop wants forty-eight colours and a palette here carries thirteen.
# What is missing is ramped or derived rather than invented, and every
# colour that carries type is lifted to a minimum contrast against the
# ground it lands on.

# The ground and the type on it. `main_bg` is the colour kitty is set to,
# so turning `theme_background` on in btop.conf gets the terminal's own
# black rather than a hole; with it off, which is how this ships, btop
# never draws it at all.
theme[main_bg]="#1e1612"
theme[main_fg]="#eef2f7"
theme[title]="#ffffff"
theme[hi_fg]="#a17a65"
theme[inactive_fg]="#53545a"
theme[graph_text]="#94a1b2"

# The selected process, in the one pair the shell already keeps for type
# on an accent — so the row is the same object the island draws when it
# highlights something.
theme[selected_bg]="#8A6754"
theme[selected_fg]="#ffffff"
theme[proc_misc]="#a17a65"

# The rest of the process box's states, and they are quieter than the
# selection on purpose: the cursor is where you are and these are what the
# list is doing. A followed process and the banner saying so take the
# accent, a paused list takes the red, and both are the ground lifted
# towards it rather than filled with it.
theme[followed_bg]="#49362c"
theme[followed_fg]="#eef2f7"
theme[proc_follow_bg]="#49362c"
theme[proc_pause_bg]="#73444e"
theme[proc_banner_bg]="#3b3432"
theme[proc_banner_fg]="#eef2f7"

# One line colour for all four boxes and for the ground behind every
# meter. Stock themes give each box its own hue; this shell draws one
# hairline and the boxes are chrome, so they are all drawn in it.
theme[cpu_box]="#322f34"
theme[mem_box]="#322f34"
theme[net_box]="#322f34"
theme[proc_box]="#322f34"
theme[div_line]="#322f34"
theme[meter_bg]="#322f34"

# Temperature and load: filling is the reading getting worse.
theme[temp_start]="#a6e3a1"
theme[temp_mid]="#f9e2af"
theme[temp_end]="#f38ba8"
theme[cpu_start]="#a6e3a1"
theme[cpu_mid]="#f9e2af"
theme[cpu_end]="#f38ba8"

# Memory. Used fills the way load does; free and available are the same
# three hues read backwards, because a full bar there is the machine being
# fine. Cached is neither, so it takes the blue and is ramped rather than
# graded.
theme[used_start]="#a6e3a1"
theme[used_mid]="#f9e2af"
theme[used_end]="#f38ba8"
theme[free_start]="#f38ba8"
theme[free_mid]="#f9e2af"
theme[free_end]="#a6e3a1"
theme[available_start]="#f38ba8"
theme[available_mid]="#f9e2af"
theme[available_end]="#a6e3a1"
theme[cached_start]="#4e5d7a"
theme[cached_mid]="#89b4fa"
theme[cached_end]="#c3d9fc"

# The two directions of the network, in the accent and the colour the
# palette keeps beside it — one hue at two weights, which is what the
# overview does with a workspace you are on and one you are going to.
# Nothing here is a warning: traffic is not good or bad.
theme[download_start]="#4e3a2f"
theme[download_mid]="#a17a65"
theme[download_end]="#ba9d8e"
theme[upload_start]="#5e473b"
theme[upload_mid]="#ad856f"
theme[upload_end]="#c3a695"

# And the process list, which fades down the screen rather than colouring
# anything: the top of it is the text colour and the bottom is the
# inactive grey.
theme[process_start]="#eef2f7"
theme[process_mid]="#94a1b2"
theme[process_end]="#53545a"
